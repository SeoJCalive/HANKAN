@page
@model SecureShare.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "사용자 관리";
    ViewData["Phase"] = "ADMIN / 사용자 관리";
}
<section class="intro" aria-labelledby="page-title">
    <p class="eyebrow">HANKAN / ADMIN</p>
    <h1 id="page-title">사용자 관리</h1>
    <p class="lead">권한 신청을 처리하고 승인된 계정의 역할을 관리합니다.</p>
</section>
@if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }
<section class="status-section" aria-labelledby="users-title">
    <div class="section-heading"><h2 id="users-title">일반 계정</h2><span>@Model.Accounts.Count 명</span></div>
    @if (Model.Accounts.Count == 0) { <p class="empty-state">가입한 일반 계정이 없습니다.</p> }
    @foreach (var account in Model.Accounts)
    {
        <article class="user-row">
            <div>
                <h3>@account.Email</h3>
                <p>상태: @(account.AccessState switch { "unrequested" => "미신청", "pending" => "승인 대기", "rejected" => "거절", "viewer" => "VIEWER", "owner" => "OWNER", "expelled" => "추방", _ => "확인 필요" })
                    @if (account.AccessState == "pending") { <span> · 신청: @account.RequestedRole</span> }
                </p>
            </div>
            <div class="user-actions">
                @if (account.AccessState is "pending" or "rejected" or "expelled" or "viewer" or "owner")
                {
                    <form method="post" class="action-form" onsubmit="return confirm('역할을 변경하면 이 사용자가 만든 공유가 취소될 수 있습니다. 업로드한 파일은 유지됩니다. 계속하시겠습니까?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TargetId" value="@account.Id" />
                        <input type="hidden" name="Action" value="grant" />
                        <label>부여할 역할 <select name="Role"><option value="VIEWER">VIEWER</option><option value="OWNER">OWNER</option></select></label>
                        <button type="submit" class="button-secondary">역할 부여</button>
                    </form>
                }
                @if (account.AccessState == "pending")
                {
                    <form method="post" class="action-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TargetId" value="@account.Id" />
                        <input type="hidden" name="Action" value="reject" />
                        <button type="submit" class="button-secondary">거절</button>
                    </form>
                }
                @if (account.AccessState is "viewer" or "owner")
                {
                    <form method="post" class="action-form" onsubmit="return confirm('추방하면 이 사용자가 만든 공유가 취소됩니다. 업로드한 파일은 유지됩니다. 계속하시겠습니까?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TargetId" value="@account.Id" />
                        <input type="hidden" name="Action" value="expel" />
                        <button type="submit" class="button-secondary">추방</button>
                    </form>
                }
            </div>
        </article>
    }
</section>
