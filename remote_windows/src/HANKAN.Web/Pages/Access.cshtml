@page
@model HANKAN.Web.Pages.AccessModel
@{
    ViewData["Title"] = "접근 권한";
    ViewData["Phase"] = "ACCOUNT / 권한";
}
<section class="auth-panel" aria-labelledby="page-title">
    <p class="eyebrow">HANKAN / ACCESS</p>
    <h1 id="page-title">접근 권한</h1>
    <p class="lead">@Model.Current?.Email</p>
    @if (Model.Error is not null) { <p class="form-error" role="alert">@Model.Error</p> }
    @if (Model.Current?.State == "unrequested")
    {
        <p class="notice">아직 공용 공간 권한이 없습니다. 역할을 선택해 관리자에게 신청하세요.</p>
        <form method="post" class="setup-form access-form">
            @Html.AntiForgeryToken()
            <fieldset class="role-options">
                <legend>희망 역할</legend>
                <label><input type="radio" name="Role" value="VIEWER" checked /> VIEWER <span>파일 목록과 다운로드</span></label>
                <label><input type="radio" name="Role" value="OWNER" /> OWNER <span>파일 업로드·다운로드</span></label>
            </fieldset>
            <button type="submit" class="button-primary">권한 신청</button>
        </form>
    }
    else if (Model.Current?.State == "pending")
    {
        <p class="notice">@Model.Current.RequestedRole 권한을 신청했습니다. 관리자 처리를 기다리고 있습니다.</p>
    }
    else if (Model.Current?.State == "rejected")
    {
        <p class="notice">권한 신청이 거절되었습니다. 재허용은 관리자가 처리합니다.</p>
    }
    else if (Model.Current?.State == "expelled")
    {
        <p class="notice">공용 공간 접근 권한이 해제되었습니다. 재허용은 관리자가 처리합니다.</p>
    }
</section>
