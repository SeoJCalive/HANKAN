@page
@model HANKAN.Web.Pages.FilesModel
@{
    ViewData["Title"] = "공용 파일";
    ViewData["Phase"] = "STORAGE / 공용 파일";
}
<section class="intro" aria-labelledby="page-title">
    <p class="eyebrow">HANKAN / FILES</p>
    <h1 id="page-title">공용 파일</h1>
    <p class="lead">승인된 사용자가 파일을 확인하고 다운로드합니다.</p>
    <p class="file-usage">사용 @Model.UsedBytes.ToString("N0") B / 전체 @Model.QuotaBytes.ToString("N0") B · 남은 용량 @Math.Max(0, Model.QuotaBytes - Model.UsedBytes).ToString("N0") B</p>
</section>
@if (Model.DeleteMessage is not null)
{
    <p class="field-help" role="status">@Model.DeleteMessage</p>
}
@if (Model.Current?.IsAdmin == true || Model.Current?.State == "owner")
{
    <section class="file-upload" aria-labelledby="upload-title">
        <h2 id="upload-title">파일 업로드</h2>
        <div class="file-upload__controls">
            <label for="upload-file">업로드할 파일</label>
            <input id="upload-file" type="file" required />
            <button id="upload-button" type="button" class="button-primary">업로드</button>
        </div>
        @Html.AntiForgeryToken()
        <p class="field-help">파일당 100 MB 미만 · 최대 99,999,999바이트</p>
        <p id="upload-status" class="field-help" role="status" aria-live="polite"></p>
    </section>
}
<section class="status-section" aria-labelledby="file-state">
    <div class="section-heading"><h2 id="file-state">파일 목록</h2><span>@(Model.Items.Count)개</span></div>
    @if (Model.Items.Count == 0)
    {
        <p class="empty-state">아직 등록된 파일이 없습니다.</p>
    }
    else
    {
        <div class="file-list">
            @foreach (var file in Model.Items)
            {
                <div class="file-row">
                    <div class="file-row__name">@file.OriginalName</div>
                    <div class="file-row__meta">@file.SizeBytes.ToString("N0") B · @file.UploaderEmail · @file.CreatedUtc.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</div>
                    <a class="button-secondary file-row__download" href="/Files?handler=Download&amp;id=@file.Id">다운로드</a>
                </div>
                @if (Model.Current?.IsAdmin == true || Model.Current?.State == "owner")
                {
                    <details class="delete-confirm">
                        <summary>영구 삭제</summary>
                        <form method="post" action="/Files?handler=Delete" class="delete-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@file.Id" />
                            <p>이 파일은 복원할 수 없으며 연결된 모든 공유가 무효화됩니다.</p>
                            <label><input type="checkbox" name="confirmation" value="delete" required /> 영향을 확인했습니다.</label>
                            <button type="submit" class="button-secondary">영구 삭제 확인</button>
                        </form>
                    </details>
                    <form method="post" action="/Shares?handler=Create" class="share-create-form" onsubmit="return this.elements['Mode'].value !== 'public' || confirm('공개 목록에 이 파일의 이름이 표시됩니다. 게시하시겠습니까?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="FileId" value="@file.Id" />
                        <input type="hidden" name="ExpiresUtc" class="expiry-utc" />
                        <label>만료 시각 <input type="datetime-local" class="expiry-local" required /></label>
                        <label>비밀번호 (선택) <input type="password" name="Password" minlength="8" maxlength="128" autocomplete="new-password" /></label>
                        @if (Model.Current?.IsAdmin == true)
                        {
                            <label>공유 방식 <select name="Mode"><option value="link">링크 전용</option><option value="public">공개 목록</option></select></label>
                        }
                        else { <input type="hidden" name="Mode" value="link" /> }
                        <button type="submit" class="button-secondary">공유 만들기</button>
                    </form>
                }
            }
        </div>
    }
</section>
@if (Model.DeletingItems.Count > 0)
{
    <section class="status-section" aria-labelledby="delete-state">
        <div class="section-heading"><h2 id="delete-state">삭제 재시도 필요</h2><span>@(Model.DeletingItems.Count)개</span></div>
        <p class="field-help">삭제가 완료될 때까지 파일과 공유에 접근할 수 없으며 용량은 계속 사용됩니다.</p>
        @foreach (var file in Model.DeletingItems)
        {
            <div class="file-row">
                <div class="file-row__name">@file.OriginalName</div>
                <div class="file-row__meta">@file.SizeBytes.ToString("N0") B · 삭제 처리 중</div>
                <form method="post" action="/Files?handler=Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@file.Id" />
                    <input type="hidden" name="confirmation" value="delete" />
                    <button type="submit" class="button-secondary">삭제 재시도</button>
                </form>
            </div>
        }
    </section>
}
@if (Model.Current?.IsAdmin == true || Model.Current?.State == "owner")
{
    <script>
        for (const form of document.querySelectorAll(".share-create-form")) {
            const local = form.querySelector(".expiry-local");
            const defaultTime = new Date(Date.now() + 7 * 86400000);
            local.value = new Date(defaultTime.getTime() - defaultTime.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            form.addEventListener("submit", () => {
                form.querySelector(".expiry-utc").value = new Date(local.value).toISOString();
            });
        }
        const input = document.getElementById("upload-file");
        const button = document.getElementById("upload-button");
        const status = document.getElementById("upload-status");
        button.addEventListener("click", async () => {
            if (!input.files.length) { status.textContent = "파일을 선택하세요."; input.focus(); return; }
            button.disabled = true;
            status.textContent = "업로드 중입니다.";
            const data = new FormData();
            data.append("file", input.files[0]);
            try {
                const response = await fetch("/FileUpload", {
                    method: "POST",
                    headers: { "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: data
                });
                if (response.ok) { location.assign("/Files"); return; }
                status.textContent = await response.text();
            } catch { status.textContent = "연결이 끊겼습니다. 다시 시도하세요."; }
            button.disabled = false;
        });
    </script>
}
