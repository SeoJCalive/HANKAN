@inject HANKAN.Web.AccessStore Access
@inject HANKAN.Web.SetupStore Setup
@inject HANKAN.Web.AccessModeRuntime AccessMode
@{
    var current = await Access.CurrentAsync(User);
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="한칸(HANKAN) — 내 PC 기반 파일 저장·공유 서비스" />
    <title>@ViewData["Title"] · 한칸(HANKAN)</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="@(ViewData["StorageLayout"] is true ? "storage-page" : "")">
    <header class="site-header">
        <div class="site-header__inner">
            <span class="brand">HAN:KAN</span>
            <span class="phase-label">@(ViewData["Phase"] ?? "HANKAN / 02")</span>
            @if (Setup.State == HANKAN.Web.SetupState.Ready)
            {
                <nav class="header-nav" aria-label="주요 메뉴">
                    <a href="/Public">공개 파일</a>
                    @if (current is null)
                    {
                        <a href="/Login">로그인</a><a href="/Register">가입</a>
                    }
                    else
                    {
                        @if (current.IsAdmin) { <a href="/Admin/Configuration">구성 정보</a> }
                        else { <a href="/">내 상태</a> }
                        @if (current.IsAdmin || current.State is "viewer" or "owner") { <a href="/Files">공용 파일</a> }
                        @if (current.IsAdmin || current.State == "owner") { <a href="/Shares">@(current.IsAdmin ? "전체 공유" : "내 공유")</a> }
                        @if (current.IsAdmin) { <a href="/Admin/Users">사용자</a><a href="/Admin/Audit">감사 기록</a> }
                        <form method="post" action="/Access?handler=Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="header-nav__logout">로그아웃</button>
                        </form>
                    }
                </nav>
            }
        </div>
    </header>
    <main id="main-content" class="page-shell">
        @if (!HANKAN.Web.AccessModeRuntime.PasswordsAllowed(Context) &&
            !(Context.Items["HANKAN.LocalControl"] is true && Setup.State != HANKAN.Web.SetupState.Ready))
        {
            <p class="notice" role="status">HTTP는 평문 전송으로 파일·링크·입력 내용의 전송 기밀성과 무결성을 보장하지 않습니다. 로그인·가입·비밀번호 공유·공유 생성은 HTTPS에서 이용하세요.</p>
        }
        @if (Context.Items["HANKAN.LocalControl"] is true && AccessMode.Failure is not null)
        {
            <p class="notice" role="alert">접속 모드 적용 실패: @AccessMode.Failure. 외부 수신을 닫고 로컬 전용으로 실행 중입니다.</p>
        }
        @if (Context.Items["HANKAN.LocalControl"] is true && AccessMode.RestartRequired)
        {
            <p class="notice">선택한 접속 모드는 최초 설정 완료 후 앱을 재시작해야 적용됩니다.</p>
        }
        @RenderBody()
    </main>
</body>
</html>
