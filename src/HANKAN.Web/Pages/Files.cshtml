@page
@model HANKAN.Web.Pages.FilesModel
@{
    ViewData["Title"] = "공용 저장소";
    ViewData["Phase"] = "STORAGE / 공용 저장소";
    ViewData["StorageLayout"] = true;
    var canManage = Model.Current?.IsAdmin == true || Model.Current?.State == "owner";
    var tree = new List<(HANKAN.Web.StoredFolder Folder, int Depth, string Path, string Ids)>();
    void AddChildren(string? parentId, int depth, string path, string ids)
    {
        foreach (var child in Model.Folder!.Tree.Where(item => item.ParentId == parentId))
        {
            var childPath = path + " / " + child.Name;
            var childIds = ids + "," + child.Id;
            tree.Add((child, depth, childPath, childIds));
            AddChildren(child.Id, depth + 1, childPath, childIds);
        }
    }
    AddChildren(null, 1, "공용 저장소", "");
}
<div class="storage-shell">
    <aside class="storage-sidebar" aria-label="폴더 탐색">
        <h2>폴더</h2>
        <nav aria-label="저장소 폴더">
            <a class="storage-tree-link @(Model.Folder!.Id is null ? "is-current" : "")" href="/Files" aria-current="@(Model.Folder.Id is null ? "page" : null)" data-drop-destination="" data-path-ids="">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h7l2 2h11v12H2z" /></svg><span>공용 저장소</span>
            </a>
            @foreach (var node in tree)
            {
                <a class="storage-tree-link @(Model.Folder.Id == node.Folder.Id ? "is-current" : "")" style="--tree-depth:@node.Depth" href="/Files?folderId=@node.Folder.Id" aria-current="@(Model.Folder.Id == node.Folder.Id ? "page" : null)" data-drop-destination="@node.Folder.Id" data-path-ids="@node.Ids">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h7l2 2h11v12H2z" /></svg><span>@node.Folder.Name</span>
                </a>
            }
        </nav>
    </aside>

    <div class="storage-main">
        <nav class="storage-breadcrumb" aria-label="현재 폴더 경로">
            @for (var index = 0; index < Model.Folder.Path.Count; index++)
            {
                var crumb = Model.Folder.Path[index];
                if (index > 0) { <span aria-hidden="true">/</span> }
                if (index == Model.Folder.Path.Count - 1)
                {
                    <span aria-current="page">@(crumb.Id is null ? "공용 저장소" : crumb.Name)</span>
                }
                else
                {
                    <a href="/Files@(crumb.Id is null ? "" : "?folderId=" + crumb.Id)">@(crumb.Id is null ? "공용 저장소" : crumb.Name)</a>
                }
            }
        </nav>

        <div class="storage-toolbar">
            @if (canManage)
            {
                <div class="storage-toolbar__actions">
                    <button type="button" class="button-primary" id="new-folder-button">새 폴더</button>
                    <button type="button" class="button-secondary" id="upload-open-button">파일 업로드</button>
                </div>
            }
            else
            {
                <p class="storage-role">보기 권한 · 폴더 탐색과 다운로드 가능</p>
            }
            <p class="storage-quota">사용 @Model.UsedBytes.ToString("N0") B / 전체 @Model.QuotaBytes.ToString("N0") B</p>
        </div>

        @if (Model.DeleteMessage is not null)
        {
            <p class="storage-notice" role="status">@Model.DeleteMessage</p>
        }
        <p id="selection-help" class="field-help storage-selection-help">클릭으로 선택 · Ctrl/Command로 추가 · Shift로 범위 선택 · Enter 또는 더블클릭으로 열기·다운로드@(canManage ? " · 데스크톱에서는 선택 항목을 폴더로 끌어 이동" : "")</p>
        <div id="selection-toolbar" class="storage-selection" role="region" aria-label="선택 항목 작업">
            @Html.AntiForgeryToken()
            <div class="storage-selection__summary" role="status" aria-live="polite">
                <strong id="selection-count">직접 선택 0개</strong>
                <span id="selection-scope">하위 포함 · 폴더 0개 · 파일 0개</span>
                <span id="selection-download-status" hidden></span>
            </div>
            <div class="storage-selection__actions">
                <a id="selection-download" class="button-secondary" hidden>다운로드</a>
                <button id="selection-download-zip" type="button" class="button-secondary" hidden>ZIP 다운로드</button>
                @if (canManage)
                {
                    <button id="selection-move" type="button" class="button-secondary" hidden>선택 항목 이동</button>
                    <button id="selection-delete" type="button" class="button-secondary" hidden>선택 항목 영구 삭제</button>
                }
                <button id="selection-retry" type="button" class="button-secondary" hidden>범위 다시 확인</button>
                <button id="selection-clear" type="button" class="button-secondary" disabled>선택 해제</button>
            </div>
            @if (canManage)
            {
                <span id="move-drag-status" class="storage-selection__feedback" role="status" aria-live="polite"></span>
            }
        </div>
        @if (canManage)
        {
            <dialog id="delete-selection-dialog" class="storage-dialog" aria-labelledby="delete-selection-title" aria-describedby="delete-selection-warning">
                <h2 id="delete-selection-title">선택 항목 영구 삭제</h2>
                <p id="delete-selection-warning">선택한 폴더의 하위 항목까지 삭제합니다. 삭제한 파일은 복원할 수 없고 연결된 공유는 무효화됩니다.</p>
                <dl class="storage-delete-impact">
                    <div><dt>폴더</dt><dd id="delete-folder-count">—</dd></div>
                    <div><dt>파일</dt><dd id="delete-file-count">—</dd></div>
                    <div><dt>파일 크기</dt><dd id="delete-size">—</dd></div>
                    <div><dt>무효화할 공유</dt><dd id="delete-share-count">—</dd></div>
                </dl>
                <label class="storage-delete-confirm"><input id="delete-selection-confirm" type="checkbox" /><span>위 영향과 복원 불가를 확인했습니다.</span></label>
                <p id="delete-selection-status" class="field-help" role="status" aria-live="polite"></p>
                <div class="storage-dialog__buttons">
                    <button id="delete-selection-cancel" type="button" class="button-secondary">취소</button>
                    <button id="delete-selection-refresh" type="button" class="button-secondary" hidden>영향 다시 확인</button>
                    <button id="delete-selection-submit" type="button" class="button-primary" disabled>영구 삭제</button>
                </div>
            </dialog>
        }
        <section id="storage-list" class="storage-list" aria-labelledby="storage-list-title" aria-describedby="selection-help" tabindex="0" data-folder-id="@Model.Folder.Id">
            <h1 id="storage-list-title" class="visually-hidden">@(Model.Folder.Path.Last().Id is null ? "공용 저장소" : Model.Folder.Path.Last().Name) 파일 목록</h1>
            <div class="storage-list-head" aria-hidden="true"><span>이름</span><span>크기</span><span>등록일</span><span>작업</span></div>
            @foreach (var folder in Model.Folder.Children)
            {
                <div class="storage-row" role="group" aria-label="폴더 @folder.Name" tabindex="0" draggable="@(canManage ? "true" : "false")" data-selection-kind="folder" data-selection-id="@folder.Id" data-open-url="/Files?folderId=@folder.Id" data-drop-destination="@folder.Id" data-path-ids="@(tree.First(node => node.Folder.Id == folder.Id).Ids)">
                    <div class="storage-row__name">
                        <label class="storage-row__select"><input type="checkbox" aria-label="@folder.Name 선택" /></label>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h7l2 2h11v12H2z" /></svg><span>@folder.Name</span>
                    </div>
                    <span class="storage-row__size" data-label="크기">—</span>
                    <time class="storage-row__date" datetime="@folder.CreatedUtc.ToString("O")">@folder.CreatedUtc.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</time>
                    <div class="storage-row__action">
                        @if (canManage)
                        {
                            <details class="storage-menu">
                                <summary aria-label="@folder.Name 작업 메뉴">···</summary>
                                <div class="storage-menu__panel">
                                    <a href="/Files?folderId=@folder.Id">열기</a>
                                    <details class="storage-subaction">
                                        <summary>이름 변경</summary>
                                        <form method="post" action="/Files?handler=RenameFolder">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
                                            <input type="hidden" name="id" value="@folder.Id" />
                                            <label>새 이름 <input name="name" value="@folder.Name" required maxlength="255" /></label>
                                            <button type="submit" class="button-secondary">변경</button>
                                        </form>
                                    </details>
                                    <button type="button" class="storage-menu__item" data-move data-kind="folder" data-id="@folder.Id" data-name="@folder.Name" data-parent-id="@(Model.Folder.Id ?? "")">이동</button>
                                    <details class="storage-subaction">
                                        <summary>삭제</summary>
                                        <form method="post" action="/Files?handler=DeleteFolder">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
                                            <input type="hidden" name="id" value="@folder.Id" />
                                            <p>빈 폴더만 삭제할 수 있습니다.</p>
                                            <button type="submit" class="button-secondary">빈 폴더 삭제</button>
                                        </form>
                                    </details>
                                </div>
                            </details>
                        }
                        else { <a href="/Files?folderId=@folder.Id" aria-label="@folder.Name 열기">열기</a> }
                    </div>
                </div>
            }
            @foreach (var file in Model.Items)
            {
                <div class="storage-row" role="group" aria-label="파일 @file.OriginalName" tabindex="0" draggable="@(canManage ? "true" : "false")" data-selection-kind="file" data-selection-id="@file.Id" data-open-url="/Files?handler=Download&amp;id=@file.Id">
                    <div class="storage-row__name">
                        <label class="storage-row__select"><input type="checkbox" aria-label="@file.OriginalName 선택" /></label>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2h9l5 5v15H5zM14 2v6h5M8 13h8M8 17h6" /></svg><span>@file.OriginalName</span>
                    </div>
                    <span class="storage-row__size" data-label="크기">@file.SizeBytes.ToString("N0") B</span>
                    <time class="storage-row__date" datetime="@file.CreatedUtc.ToString("O")">@file.CreatedUtc.ToLocalTime().ToString("yyyy.MM.dd HH:mm")</time>
                    <div class="storage-row__action">
                        @if (canManage)
                        {
                            <details class="storage-menu">
                                <summary aria-label="@file.OriginalName 작업 메뉴">···</summary>
                                <div class="storage-menu__panel">
                                    <a href="/Files?handler=Download&amp;id=@file.Id">다운로드</a>
                                    <details class="storage-subaction">
                                        <summary>이름 변경</summary>
                                        <form method="post" action="/Files?handler=RenameFile">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
                                            <input type="hidden" name="id" value="@file.Id" />
                                            <label>새 이름 <input name="name" value="@file.OriginalName" required maxlength="255" /></label>
                                            <button type="submit" class="button-secondary">변경</button>
                                        </form>
                                    </details>
                                    <button type="button" class="storage-menu__item" data-move data-kind="file" data-id="@file.Id" data-name="@file.OriginalName" data-parent-id="@(Model.Folder.Id ?? "")">이동</button>
                                    <details class="storage-subaction">
                                        <summary>링크 공유</summary>
                                        <form method="post" action="/Shares?handler=Create" class="share-create-form" onsubmit="return this.elements['Mode'].value !== 'public' || confirm('공개 목록에 이 파일의 이름이 표시됩니다. 게시하시겠습니까?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="FileId" value="@file.Id" />
                                            <input type="hidden" name="ExpiresUtc" class="expiry-utc" />
                                            <label>만료 시각 <input type="datetime-local" class="expiry-local" required /></label>
                                            <p class="field-help">기본 1일. 현재부터 1시간 초과~7일 이내로 선택하세요.</p>
                                            <label>비밀번호 (선택) <input type="password" name="Password" minlength="8" maxlength="128" autocomplete="new-password" /></label>
                                            @if (Model.Current?.IsAdmin == true)
                                            {
                                                <label>공유 방식 <select name="Mode"><option value="link">링크 전용</option><option value="public">공개 목록</option></select></label>
                                            }
                                            else { <input type="hidden" name="Mode" value="link" /> }
                                            <button type="submit" class="button-secondary">공유 만들기</button>
                                        </form>
                                    </details>
                                    <details class="storage-subaction">
                                        <summary>영구 삭제</summary>
                                        <form method="post" action="/Files?handler=Delete" class="delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@file.Id" />
                                            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
                                            <p>복원할 수 없으며 연결된 공유가 무효화됩니다.</p>
                                            <label><input type="checkbox" name="confirmation" value="delete" required /> 영향을 확인했습니다.</label>
                                            <button type="submit" class="button-secondary">영구 삭제 확인</button>
                                        </form>
                                    </details>
                                </div>
                            </details>
                        }
                        else { <a href="/Files?handler=Download&amp;id=@file.Id" aria-label="@file.OriginalName 다운로드">다운로드</a> }
                    </div>
                </div>
            }
            @if (Model.Folder.Children.Count == 0 && Model.Items.Count == 0)
            {
                <p class="empty-state">이 폴더는 비어 있습니다.</p>
            }
            <div id="selection-marquee" class="storage-marquee" hidden aria-hidden="true"></div>
        </section>

        @if (canManage && Model.DeletingItems.Count > 0)
        {
            <section class="storage-retry" aria-labelledby="delete-state">
                <h2 id="delete-state">삭제 재시도 필요 · @Model.DeletingItems.Count.ToString("N0")개</h2>
                <p class="field-help">위치와 관계없이 삭제 처리 중인 파일입니다. 완료 전에는 파일과 공유에 접근할 수 없고 용량을 사용합니다.</p>
                @foreach (var file in Model.DeletingItems)
                {
                    <div class="storage-retry__row">
                        <span>@file.OriginalName</span>
                        <form method="post" action="/Files?handler=Delete">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@file.Id" />
                            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
                            <input type="hidden" name="confirmation" value="delete" />
                            <button type="submit" class="button-secondary">삭제 재시도</button>
                        </form>
                    </div>
                }
            </section>
        }
    </div>
</div>

<script>
    (() => {
        const list = document.getElementById("storage-list");
        const rows = [...list.querySelectorAll("[data-selection-id]")];
        const toolbar = document.getElementById("selection-toolbar");
        const count = document.getElementById("selection-count");
        const scope = document.getElementById("selection-scope");
        const download = document.getElementById("selection-download");
        const downloadZip = document.getElementById("selection-download-zip");
        const downloadStatus = document.getElementById("selection-download-status");
        const retry = document.getElementById("selection-retry");
        const marquee = document.getElementById("selection-marquee");
        const deleteButton = document.getElementById("selection-delete");
        const deleteDialog = document.getElementById("delete-selection-dialog");
        const deleteConfirm = document.getElementById("delete-selection-confirm");
        const deleteSubmit = document.getElementById("delete-selection-submit");
        const deleteStatus = document.getElementById("delete-selection-status");
        const deleteRefresh = document.getElementById("delete-selection-refresh");
        let deleteToken = null;
        let deletingSelection = false;
        let selected = new Set();
        let anchor = null;
        let request = null;
        let summaryTimer;
        let drag = null;
        let ignoreClick = false;

        function paintSelection(updateToolbar = true) {
            for (const row of rows) {
                const checked = selected.has(row);
                row.classList.toggle("is-selected", checked);
                row.querySelector('.storage-row__select input').checked = checked;
            }
            if (!updateToolbar) return;
            document.getElementById("selection-clear").disabled = selected.size === 0;
            count.textContent = `직접 선택 ${selected.size.toLocaleString()}개`;
        }

        function selectionData() {
            const data = new URLSearchParams({ folderId: list.dataset.folderId });
            for (const row of selected) data.append(row.dataset.selectionKind === "folder" ? "folderIds" : "fileIds", row.dataset.selectionId);
            return data;
        }

        async function loadSummary() {
            const currentRequest = new AbortController();
            request = currentRequest;
            try {
                const response = await fetch("/Files?handler=SelectionSummary", {
                    method: "POST",
                    headers: { "RequestVerificationToken": toolbar.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: selectionData(),
                    signal: currentRequest.signal
                });
                const result = await response.json();
                if (request !== currentRequest || currentRequest.signal.aborted) return;
                if (!response.ok) throw new Error(result.message || "선택 범위를 확인할 수 없습니다.");
                count.textContent = `직접 선택 ${result.directCount.toLocaleString()}개`;
                scope.textContent = `하위 포함 · 폴더 ${result.folderCount.toLocaleString()}개 · 파일 ${result.fileCount.toLocaleString()}개`;
                const only = selected.size === 1 ? [...selected][0] : null;
                if (only?.dataset.selectionKind === "file") {
                    download.href = only.dataset.openUrl;
                    download.hidden = false;
                } else downloadZip.hidden = false;
            } catch (error) {
                if (request !== currentRequest || currentRequest.signal.aborted) return;
                scope.textContent = error instanceof SyntaxError || error instanceof TypeError
                    ? "선택 범위를 확인하지 못했습니다. 연결과 로그인 상태를 확인한 뒤 다시 시도하세요."
                    : error.message;
                retry.hidden = false;
            }
        }

        function updateSelection() {
            clearTimeout(summaryTimer);
            request?.abort();
            request = null;
            paintSelection();
            download.hidden = true;
            download.removeAttribute("href");
            downloadZip.hidden = true;
            downloadStatus.hidden = true;
            downloadStatus.textContent = "";
            retry.hidden = true;
            scope.textContent = selected.size ? "하위 포함 범위 확인 중…" : "하위 포함 · 폴더 0개 · 파일 0개";
            const move = document.getElementById("selection-move");
            if (move) move.hidden = selected.size === 0;
            if (deleteButton) deleteButton.hidden = selected.size === 0;
            if (deleteDialog?.open) deleteDialog.close();
            if (selected.size) summaryTimer = setTimeout(loadSummary, 120);
        }

        if (deleteButton) {
            const verificationToken = toolbar.querySelector('input[name="__RequestVerificationToken"]').value;
            async function previewDelete() {
                deleteButton.disabled = true;
                deleteConfirm.checked = false;
                deleteSubmit.disabled = true;
                deleteRefresh.hidden = true;
                deleteToken = null;
                deleteStatus.textContent = "삭제 영향을 확인하는 중…";
                try {
                    const response = await fetch("/Files?handler=DeletePreview", {
                        method: "POST",
                        headers: { "RequestVerificationToken": verificationToken },
                        body: selectionData()
                    });
                    const result = response.headers.get("Content-Type")?.includes("application/json") ? await response.json() : null;
                    if (!response.ok) throw new Error(result?.message || "삭제 영향을 확인하지 못했습니다.");
                    deleteToken = result.previewToken;
                    document.getElementById("delete-folder-count").textContent = `${result.folderCount.toLocaleString()}개`;
                    document.getElementById("delete-file-count").textContent = `${result.fileCount.toLocaleString()}개`;
                    document.getElementById("delete-size").textContent = `${result.totalBytes.toLocaleString()} B`;
                    document.getElementById("delete-share-count").textContent = `${result.shareCount.toLocaleString()}개`;
                    deleteStatus.textContent = "영향을 확인한 뒤 영구 삭제를 선택하세요.";
                    deleteSubmit.disabled = !deleteConfirm.checked;
                } catch (error) {
                    deleteStatus.textContent = error instanceof Error ? error.message : "삭제 영향을 확인하지 못했습니다.";
                    deleteRefresh.hidden = false;
                } finally {
                    deleteButton.disabled = false;
                }
            }
            deleteButton.addEventListener("click", () => {
                if (!selected.size || deleteDialog.open) return;
                deleteDialog.showModal();
                void previewDelete();
            });
            deleteDialog.addEventListener("close", () => {
                deleteToken = null;
                deleteConfirm.checked = false;
                deleteSubmit.disabled = true;
            });
            deleteConfirm.addEventListener("change", () => {
                deleteSubmit.disabled = !deleteConfirm.checked || !deleteToken || deletingSelection;
            });
            deleteRefresh.addEventListener("click", () => void previewDelete());
            document.getElementById("delete-selection-cancel").addEventListener("click", () => {
                if (!deletingSelection) deleteDialog.close();
            });
            deleteSubmit.addEventListener("click", async () => {
                if (!deleteToken || !deleteConfirm.checked || deletingSelection) return;
                deletingSelection = true;
                deleteSubmit.disabled = true;
                deleteStatus.textContent = "영구 삭제 처리 중…";
                const data = selectionData();
                data.set("previewToken", deleteToken);
                try {
                    const response = await fetch("/Files?handler=DeleteSelection", {
                        method: "POST",
                        headers: { "RequestVerificationToken": verificationToken },
                        body: data
                    });
                    const result = response.headers.get("Content-Type")?.includes("application/json") ? await response.json() : null;
                    if (response.status === 409) {
                        deleteToken = null;
                        deleteConfirm.checked = false;
                        deleteRefresh.hidden = false;
                        deleteStatus.textContent = result?.message || "삭제 영향이 변경됐습니다. 다시 확인하세요.";
                        return;
                    }
                    if (!response.ok) throw new Error(result?.message || "영구 삭제를 완료하지 못했습니다.");
                    const deletedFiles = result.deletedFileCount.toLocaleString();
                    const deletedFolders = result.deletedFolderCount.toLocaleString();
                    const retryFiles = result.retryFileCount.toLocaleString();
                    const remainingFolders = result.remainingFolderCount.toLocaleString();
                    const message = result.partial
                        ? `파일 ${deletedFiles}개와 폴더 ${deletedFolders}개를 삭제했습니다. 파일 ${retryFiles}개는 아래 삭제 재시도가 필요하며 폴더 ${remainingFolders}개가 남았습니다. 파일 재시도 후 남은 폴더를 선택해 영향을 다시 확인하세요.`
                        : `파일 ${deletedFiles}개와 폴더 ${deletedFolders}개를 영구 삭제했습니다.`;
                    sessionStorage.setItem("hankan-delete-result", message);
                    location.reload();
                } catch (error) {
                    deleteStatus.textContent = error instanceof Error ? error.message : "영구 삭제를 완료하지 못했습니다.";
                    deleteRefresh.hidden = false;
                    deleteToken = null;
                    deleteConfirm.checked = false;
                } finally {
                    deletingSelection = false;
                    deleteSubmit.disabled = true;
                }
            });
            const previousResult = sessionStorage.getItem("hankan-delete-result");
            if (previousResult) {
                sessionStorage.removeItem("hankan-delete-result");
                const notice = document.createElement("p");
                notice.className = "storage-notice";
                notice.setAttribute("role", "status");
                notice.textContent = previousResult;
                toolbar.before(notice);
            }
        }

        function selectRow(row, event, toggle = false) {
            if (event.shiftKey && anchor !== null) {
                const first = rows.indexOf(anchor);
                const last = rows.indexOf(row);
                if (!event.ctrlKey && !event.metaKey) selected.clear();
                for (const item of rows.slice(Math.min(first, last), Math.max(first, last) + 1)) selected.add(item);
            } else {
                if (toggle || event.ctrlKey || event.metaKey) {
                    if (selected.has(row)) selected.delete(row);
                    else selected.add(row);
                } else selected = new Set([row]);
                anchor = row;
            }
            updateSelection();
        }

        function clearSelection() {
            selected.clear();
            anchor = null;
            updateSelection();
        }

        document.getElementById("selection-clear").addEventListener("click", () => {
            clearSelection();
            list.focus();
        });
        retry.addEventListener("click", updateSelection);
        downloadZip.addEventListener("click", async () => {
            if (!selected.size || downloadZip.disabled) return;
            downloadZip.disabled = true;
            downloadStatus.hidden = false;
            downloadStatus.textContent = "ZIP 준비 중…";
            try {
                const response = await fetch("/Files?handler=DownloadSelection", {
                    method: "POST",
                    headers: { "RequestVerificationToken": toolbar.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: selectionData()
                });
                if (!response.ok || !response.headers.get("Content-Type")?.includes("application/zip")) {
                    const error = response.headers.get("Content-Type")?.includes("application/json") ? await response.json() : null;
                    throw new Error(error?.message || "ZIP을 받을 수 없습니다. 로그인과 선택 항목을 확인한 뒤 다시 시도하세요.");
                }
                const url = URL.createObjectURL(await response.blob());
                const link = document.createElement("a");
                link.href = url;
                link.download = "HANKAN-selection.zip";
                document.body.append(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
                downloadStatus.textContent = "ZIP 다운로드를 시작했습니다.";
            } catch (error) {
                downloadStatus.textContent = error instanceof TypeError || error?.name === "AbortError"
                    ? "ZIP 전송이 중단됐습니다. 연결과 저장소 상태를 확인한 뒤 다시 시도하세요."
                    : error instanceof Error ? error.message : "ZIP 다운로드를 완료하지 못했습니다.";
            } finally {
                downloadZip.disabled = false;
            }
        });
        list.addEventListener("click", event => {
            if (ignoreClick) { ignoreClick = false; return; }
            if (event.target.closest(".storage-row__action")) return;
            const row = event.target.closest("[data-selection-id]");
            if (!row) return;
            if (event.target.closest(".storage-row__select")) {
                if (event.target.matches("input")) selectRow(row, event, true);
                return;
            }
            row.focus({ preventScroll: true });
            selectRow(row, event);
        });
        list.addEventListener("dblclick", event => {
            if (event.target.closest(".storage-row__action, .storage-row__select")) return;
            const row = event.target.closest("[data-selection-id]");
            if (row) location.assign(row.dataset.openUrl);
        });
        list.addEventListener("keydown", event => {
            if (event.target.closest(".storage-row__action")) return;
            const row = event.target.closest("[data-selection-id]");
            if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "a") {
                event.preventDefault();
                selected = new Set(rows);
                anchor = row || rows[0] || null;
                updateSelection();
            } else if (event.key === "Escape") {
                event.preventDefault();
                clearSelection();
            } else if (event.key === "Enter" && row) {
                event.preventDefault();
                location.assign(row.dataset.openUrl);
            } else if (event.key === " " && row && !event.target.matches("input")) {
                event.preventDefault();
                selectRow(row, event, true);
            } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
                event.preventDefault();
                const next = rows[Math.max(0, Math.min(rows.length - 1, rows.indexOf(row) + (event.key === "ArrowDown" ? 1 : -1)))];
                if (next) {
                    next.focus();
                    if (!event.ctrlKey && !event.metaKey) selectRow(next, event);
                }
            }
        });

        list.addEventListener("pointerdown", event => {
            if (event.pointerType !== "mouse" || event.button !== 0 || event.target.closest(".storage-row, .storage-list-head")) return;
            ignoreClick = false;
            clearTimeout(summaryTimer);
            request?.abort();
            drag = { id: event.pointerId, x: event.pageX, y: event.pageY, original: new Set(selected), additive: event.ctrlKey || event.metaKey, moved: false };
            list.setPointerCapture(event.pointerId);
            list.focus({ preventScroll: true });
            event.preventDefault();
        });
        list.addEventListener("pointermove", event => {
            if (!drag || event.pointerId !== drag.id) return;
            if (!drag.moved && Math.hypot(event.pageX - drag.x, event.pageY - drag.y) < 4) return;
            drag.moved = true;
            const left = Math.min(drag.x, event.pageX);
            const top = Math.min(drag.y, event.pageY);
            const right = Math.max(drag.x, event.pageX);
            const bottom = Math.max(drag.y, event.pageY);
            marquee.hidden = false;
            Object.assign(marquee.style, { left: `${left - scrollX}px`, top: `${top - scrollY}px`, width: `${right - left}px`, height: `${bottom - top}px` });
            selected = new Set(drag.additive ? drag.original : []);
            for (const row of rows) {
                const rect = row.getBoundingClientRect();
                if (rect.right + scrollX > left && rect.left + scrollX < right && rect.bottom + scrollY > top && rect.top + scrollY < bottom) selected.add(row);
            }
            paintSelection(false);
        });
        function finishDrag(event) {
            if (!drag || event.pointerId !== drag.id) return;
            const finished = drag;
            drag = null;
            marquee.hidden = true;
            if (list.hasPointerCapture(event.pointerId)) list.releasePointerCapture(event.pointerId);
            if (event.type === "pointercancel" || event.type === "lostpointercapture") selected = finished.original;
            else if (!finished.moved && !finished.additive) selected.clear();
            ignoreClick = finished.moved;
            setTimeout(() => { ignoreClick = false; }, 0);
            anchor = [...selected][0] || null;
            updateSelection();
        }
        list.addEventListener("pointerup", finishDrag);
        list.addEventListener("pointercancel", finishDrag);
        list.addEventListener("lostpointercapture", finishDrag);
        window.addEventListener("pagehide", clearSelection);
        window.addEventListener("pageshow", event => { if (event.persisted) clearSelection(); });
    })();
    if (matchMedia("(max-width: 800px)").matches) {
        document.querySelector('.storage-tree-link[aria-current="page"]')?.scrollIntoView({ block: "nearest", inline: "nearest" });
    }
</script>

@if (canManage)
{
    <dialog id="new-folder-dialog" class="storage-dialog" aria-labelledby="new-folder-title">
        <h2 id="new-folder-title">새 폴더</h2>
        <p>현재 위치: @string.Join(" / ", Model.Folder.Path.Select(crumb => crumb.Id is null ? "공용 저장소" : crumb.Name))</p>
        <form method="post" action="/Files?handler=CreateFolder">
            @Html.AntiForgeryToken()
            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
            <label>폴더 이름 <input name="name" required maxlength="255" /></label>
            <div class="storage-dialog__buttons"><button type="button" class="button-secondary" data-close-dialog>취소</button><button type="submit" class="button-primary">폴더 만들기</button></div>
        </form>
    </dialog>
    <dialog id="upload-dialog" class="storage-dialog" aria-labelledby="upload-title">
        <h2 id="upload-title">파일 업로드</h2>
        <p>현재 위치: @string.Join(" / ", Model.Folder.Path.Select(crumb => crumb.Id is null ? "공용 저장소" : crumb.Name))</p>
        <label>업로드할 파일 <input id="upload-file" type="file" required /></label>
        @Html.AntiForgeryToken()
        <p class="field-help">파일당 100 MB 미만 · 최대 99,999,999바이트</p>
        <p id="upload-status" class="field-help" role="status" aria-live="polite"></p>
        <div class="storage-dialog__buttons"><button type="button" class="button-secondary" data-close-dialog>취소</button><button id="upload-button" type="button" class="button-primary">업로드</button></div>
    </dialog>
    <dialog id="move-dialog" class="storage-dialog" aria-labelledby="move-title">
        <h2 id="move-title">이동할 위치 선택</h2>
        <p>선택한 <span id="move-kind"></span>: <strong id="move-item"></strong></p>
        <p id="move-scope" class="field-help" hidden>선택한 폴더의 하위 항목도 함께 이동합니다.</p>
        <form method="post" id="move-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="folderId" value="@Model.Folder.Id" />
            <input type="hidden" name="id" id="move-id" />
            <input type="hidden" name="destinationId" id="move-destination" />
            <fieldset class="storage-destinations">
                <legend>목적지 폴더</legend>
                <label class="storage-destinations__item" data-path="공용 저장소" data-path-ids="">
                    <input type="radio" name="destinationChoice" value="" checked /><span>공용 저장소</span>
                </label>
                @foreach (var node in tree)
                {
                    <label class="storage-destinations__item" style="--tree-depth:@node.Depth" data-path="@node.Path" data-path-ids="@node.Ids">
                        <input type="radio" name="destinationChoice" value="@node.Folder.Id" /><span>@node.Folder.Name</span>
                    </label>
                }
            </fieldset>
            <p>선택한 위치 <strong id="move-path">공용 저장소</strong></p>
            <p id="move-warning" class="field-help" role="status" aria-live="polite"></p>
            <div class="storage-dialog__buttons"><button type="button" class="button-secondary" data-close-dialog>취소</button><button type="submit" id="move-submit" class="button-primary">여기로 이동</button></div>
        </form>
    </dialog>
    <script>
        for (const form of document.querySelectorAll(".share-create-form")) {
            const local = form.querySelector(".expiry-local");
            const defaultTime = new Date(Date.now() + 1 * 86400000);
            local.value = new Date(defaultTime.getTime() - defaultTime.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            form.addEventListener("submit", () => {
                form.querySelector(".expiry-utc").value = new Date(local.value).toISOString();
            });
        }
        const folderDialog = document.getElementById("new-folder-dialog");
        const uploadDialog = document.getElementById("upload-dialog");
        const moveDialog = document.getElementById("move-dialog");
        document.getElementById("new-folder-button").addEventListener("click", () => folderDialog.showModal());
        document.getElementById("upload-open-button").addEventListener("click", () => uploadDialog.showModal());
        for (const button of document.querySelectorAll("[data-close-dialog]")) {
            button.addEventListener("click", () => button.closest("dialog").close());
        }
        const moveForm = document.getElementById("move-form");
        const moveWarning = document.getElementById("move-warning");
        const moveSubmit = document.getElementById("move-submit");
        const list = document.getElementById("storage-list");
        const dragStatus = document.getElementById("move-drag-status");
        const moveButton = document.getElementById("selection-move");
        let moving = null;
        let dragRoots = null;
        let dropTarget = null;
        let movePending = false;
        function selectedRows() {
            return [...list.querySelectorAll(".storage-row.is-selected")];
        }
        function moveData(roots, destination) {
            const data = new URLSearchParams({ folderId: list.dataset.folderId, destinationId: destination });
            for (const row of roots) data.append(row.dataset.selectionKind === "folder" ? "folderIds" : "fileIds", row.dataset.selectionId);
            return data;
        }
        function destinationProblem(roots, destination, pathIds) {
            if (destination === list.dataset.folderId) return "이미 이 위치에 있습니다. 다른 폴더를 선택하세요.";
            const ancestors = pathIds.split(",");
            if (roots.some(row => row.dataset.selectionKind === "folder" && ancestors.includes(row.dataset.selectionId)))
                return "폴더를 자기 자신이나 하위 폴더로 이동할 수 없습니다.";
            return "";
        }
        async function moveSelection(roots, destination) {
            if (movePending) return;
            movePending = true;
            moveSubmit.disabled = true;
            dragStatus.textContent = "선택 항목 이동 중…";
            let failureMessage = null;
            try {
                const response = await fetch("/Files?handler=MoveSelection", {
                    method: "POST",
                    headers: { "RequestVerificationToken": moveForm.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: moveData(roots, destination)
                });
                const result = response.headers.get("Content-Type")?.includes("application/json") ? await response.json() : null;
                if (!response.ok) throw new Error(result?.message || "이동하지 못했습니다. 로그인과 선택 항목을 다시 확인하세요.");
                location.reload();
            } catch (error) {
                failureMessage = error instanceof Error ? error.message : "이동하지 못했습니다. 다시 시도하세요.";
                dragStatus.textContent = failureMessage;
            } finally {
                movePending = false;
                updateDestination();
                if (failureMessage) moveWarning.textContent = failureMessage;
            }
        }
        function updateDestination() {
            if (!moving) return;
            const choice = moveForm.querySelector('input[name="destinationChoice"]:checked');
            const destination = choice.value;
            const path = choice.closest("label").dataset.path;
            const pathIds = choice.closest("label").dataset.pathIds;
            const problem = moving.kind === "selection"
                ? destinationProblem(moving.roots, destination, pathIds)
                : moving.kind === "folder" && pathIds.split(",").includes(moving.id)
                    ? "폴더를 자기 자신이나 하위 폴더로 이동할 수 없습니다."
                    : destination === moving.parentId ? "이미 이 위치에 있습니다. 다른 폴더를 선택하세요." : "";
            document.getElementById("move-destination").value = destination;
            document.getElementById("move-path").textContent = path;
            moveWarning.textContent = problem;
            moveSubmit.disabled = Boolean(problem) || movePending;
        }
        moveButton.addEventListener("click", () => {
            const roots = selectedRows();
            if (!roots.length) return;
            moving = { kind: "selection", roots };
            document.getElementById("move-id").value = "";
            document.getElementById("move-kind").textContent = "항목";
            document.getElementById("move-item").textContent = `${roots.length.toLocaleString()}개 (폴더 ${roots.filter(row => row.dataset.selectionKind === "folder").length.toLocaleString()}개 · 파일 ${roots.filter(row => row.dataset.selectionKind === "file").length.toLocaleString()}개)`;
            document.getElementById("move-scope").hidden = !roots.some(row => row.dataset.selectionKind === "folder");
            moveForm.querySelector('input[name="destinationChoice"][value="' + list.dataset.folderId + '"]').checked = true;
            updateDestination();
            moveDialog.showModal();
        });
        for (const button of document.querySelectorAll("[data-move]")) {
            button.addEventListener("click", () => {
                moving = button.dataset;
                button.closest(".storage-menu").open = false;
                moveForm.action = "/Files?handler=" + (moving.kind === "folder" ? "MoveFolder" : "MoveFile");
                document.getElementById("move-id").value = moving.id;
                document.getElementById("move-kind").textContent = moving.kind === "folder" ? "폴더" : "파일";
                document.getElementById("move-item").textContent = moving.name;
                document.getElementById("move-scope").hidden = true;
                const initial = moveForm.querySelector('input[name="destinationChoice"][value="' + moving.parentId + '"]');
                (initial || moveForm.querySelector('input[name="destinationChoice"]')).checked = true;
                updateDestination();
                moveDialog.showModal();
            });
        }
        for (const choice of moveForm.querySelectorAll('input[name="destinationChoice"]')) {
            choice.addEventListener("change", updateDestination);
        }
        moveForm.addEventListener("submit", event => {
            updateDestination();
            if (moveSubmit.disabled) { event.preventDefault(); return; }
            if (moving.kind === "selection") {
                event.preventDefault();
                void moveSelection(moving.roots, document.getElementById("move-destination").value);
            }
        });
        function clearDropTarget() {
            dropTarget?.classList.remove("is-drop-target", "is-drop-blocked");
            dropTarget = null;
        }
        list.addEventListener("dragstart", event => {
            const row = event.target.closest(".storage-row[data-selection-id]");
            if (!row || event.target.closest(".storage-row__select, .storage-row__action")) {
                event.preventDefault();
                return;
            }
            dragRoots = row.classList.contains("is-selected") ? selectedRows() : [row];
            event.dataTransfer.effectAllowed = "move";
            event.dataTransfer.setData("text/plain", `${dragRoots.length}개 항목 이동`);
            dragStatus.textContent = `${dragRoots.length.toLocaleString()}개 항목을 폴더로 끌어 이동합니다.`;
        });
        document.addEventListener("dragover", event => {
            if (!dragRoots) return;
            const target = event.target.closest("[data-drop-destination]");
            if (target !== dropTarget) {
                clearDropTarget();
                dropTarget = target;
            }
            if (!target || event.target.closest(".storage-row__select, .storage-row__action")) return;
            event.preventDefault();
            const problem = destinationProblem(dragRoots, target.dataset.dropDestination, target.dataset.pathIds);
            target.classList.toggle("is-drop-target", !problem);
            target.classList.toggle("is-drop-blocked", Boolean(problem));
            event.dataTransfer.dropEffect = problem ? "none" : "move";
            dragStatus.textContent = problem || `${dragRoots.length.toLocaleString()}개 항목을 이 폴더로 이동합니다.`;
        });
        document.addEventListener("drop", event => {
            if (!dragRoots) return;
            const target = event.target.closest("[data-drop-destination]");
            if (!target) return;
            event.preventDefault();
            const problem = destinationProblem(dragRoots, target.dataset.dropDestination, target.dataset.pathIds);
            const roots = dragRoots;
            dragRoots = null;
            clearDropTarget();
            if (problem) { dragStatus.textContent = problem; return; }
            moving = { kind: "selection", roots };
            void moveSelection(roots, target.dataset.dropDestination);
        });
        list.addEventListener("dragend", () => {
            dragRoots = null;
            clearDropTarget();
        });
        const input = document.getElementById("upload-file");
        const button = document.getElementById("upload-button");
        const status = document.getElementById("upload-status");
        button.addEventListener("click", async () => {
            if (!input.files.length) { status.textContent = "파일을 선택하세요."; input.focus(); return; }
            button.disabled = true;
            status.textContent = "업로드 중입니다.";
            const data = new FormData();
            data.append("file", input.files[0]);
            try {
                const folderId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Folder.Id));
                const response = await fetch("/FileUpload" + (folderId === null ? "" : "?folderId=" + encodeURIComponent(folderId)), {
                    method: "POST",
                    headers: { "RequestVerificationToken": uploadDialog.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: data
                });
                if (response.ok) { location.assign("/Files" + (folderId === null ? "" : "?folderId=" + encodeURIComponent(folderId))); return; }
                status.textContent = await response.text();
            } catch { status.textContent = "연결이 끊겼습니다. 다시 시도하세요."; }
            button.disabled = false;
        });
    </script>
}
