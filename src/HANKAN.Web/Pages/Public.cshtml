@page
@model HANKAN.Web.Pages.PublicModel
@{
    ViewData["Title"] = "공개 파일";
    ViewData["Phase"] = "PUBLIC / 공개 파일";
}
<section class="intro" aria-labelledby="page-title">
    <p class="eyebrow">HANKAN / PUBLIC</p>
    <h1 id="page-title">공개 파일</h1>
    <p class="lead">관리자가 게시한 파일을 확인하고 다운로드할 수 있습니다.</p>
</section>
<section class="status-section" aria-labelledby="public-title">
    <div class="section-heading"><h2 id="public-title">게시 목록</h2><span>@Model.Items.Count 개</span></div>
    @if (Model.Items.Count == 0) { <p class="empty-state">현재 공개된 파일이 없습니다.</p> }
    <div class="file-list">
        @foreach (var item in Model.Items)
        {
            <div class="file-row">
                <div class="file-row__name">@item.Name</div>
                <div class="file-row__meta">@item.SizeBytes.ToString("N0") B · @(item.PasswordNeeded ? "비밀번호 필요" : "비밀번호 없음")</div>
                <a class="button-secondary file-row__download" href="/Share/@item.Token" rel="noreferrer">열기</a>
            </div>
        }
    </div>
</section>
